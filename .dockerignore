# Ignore version control metadata
.git
.gitignore

# Ignore local package dependencies (re-installed inside the container)
node_modules/
jspm_packages/
venv/
.venv/
ENV/

# Ignore local environment files and secrets
.env
.env.*
*.pem
*.key
id_rsa

# Ignore heavy build artifacts and caches
dist/
build/
.next/
.nuxt/
.out/
.cache/
__pycache__/
*.pyc

# Ignore testing, documentation, and logs
coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
docs/
*.md

# Ignore Docker-specific files not needed inside the image
Dockerfile
.dockerignore
